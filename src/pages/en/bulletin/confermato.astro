---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const email = Astro.url.searchParams.get('email') || '';
const already = Astro.url.searchParams.get('already') === '1';
---
<BaseLayout title={already ? 'Already subscribed · Pianeta Bulletin' : 'Subscription confirmed · Pianeta Bulletin'} description="Subscription active.">
  <div class="bulletin-flow">
    <h1 class="bulletin-flow-title">
      {already ? 'Subscription already active' : 'Subscription confirmed'}
    </h1>
    <p class="bulletin-flow-body">
      {already ? (
        <span>{email && <strong>{email}</strong>} is already subscribed. All good.</span>
      ) : (
        <span>From today you'll receive Pianeta.Studio's Bulletin{email && ` at `}{email && <strong>{email}</strong>}.</span>
      )}
    </p>
    <p class="bulletin-flow-note">We sent you a welcome email with the link to your preferences.</p>
    <div class="bulletin-flow-actions">
      <a href="/en/bulletin" class="cta-btn cta-primary">Read the articles →</a>
      <a href="/en" class="cta-btn cta-ghost">Go to homepage</a>
    </div>
  </div>
</BaseLayout>

<style>
.bulletin-flow {
  max-width: 600px;
  margin: 0 auto;
  padding: 80px 24px 96px;
  text-align: center;
}
.bulletin-flow-title {
  font-size: var(--ty-hero);
  font-weight: 600;
  letter-spacing: var(--ty-hero-tracking);
  line-height: var(--ty-hero-lh);
  margin: 0 0 24px;
}
.bulletin-flow-body {
  font-size: 1.1rem;
  color: var(--pianeta-muted-strong);
  line-height: 1.6;
  margin: 0 0 12px;
}
.bulletin-flow-note {
  font-size: 0.875rem;
  color: var(--pianeta-muted);
  margin: 0 0 40px;
}
.bulletin-flow-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12px;
}
</style>
