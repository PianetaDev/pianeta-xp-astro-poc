---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const email = Astro.url.searchParams.get('email') || '';
---
<BaseLayout title="Thanks · Pianeta Bulletin" description="Check your inbox to confirm the subscription.">
  <div class="bulletin-flow">
    <h1 class="bulletin-flow-title">Check your inbox</h1>
    <p class="bulletin-flow-body">
      We sent you an email{email && ` at `}{email && <strong>{email}</strong>} with the link to confirm your subscription.
    </p>
    <p class="bulletin-flow-note">
      Can't find it in a few minutes? Check spam or write us at <a href="mailto:bulletin@pianeta.studio">bulletin@pianeta.studio</a>.
    </p>
    <div class="bulletin-flow-actions">
      <a href="/en/bulletin" class="cta-btn cta-ghost">← Back to the Bulletin</a>
    </div>
  </div>
</BaseLayout>

<style>
.bulletin-flow {
  max-width: 600px;
  margin: 0 auto;
  padding: 80px 24px 96px;
  text-align: center;
}
.bulletin-flow-title {
  font-size: var(--ty-hero);
  font-weight: 600;
  letter-spacing: var(--ty-hero-tracking);
  line-height: var(--ty-hero-lh);
  margin: 0 0 24px;
}
.bulletin-flow-body {
  font-size: 1.1rem;
  color: var(--pianeta-muted-strong);
  line-height: 1.6;
  margin: 0 0 12px;
}
.bulletin-flow-note {
  font-size: 0.875rem;
  color: var(--pianeta-muted);
  margin: 0 0 40px;
}
.bulletin-flow-note a {
  color: inherit;
  text-decoration: underline;
}
.bulletin-flow-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12px;
}
</style>
