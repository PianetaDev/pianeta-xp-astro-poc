---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Iscriviti al Bulletin — Pianeta.Studio" description="Articoli, casi reali, ricerca. 1-2 al mese da Pianeta.Studio.">
  <div class="bulletin-subscribe">
    <header class="bulletin-subscribe-head">
      <p class="index-eyebrow">Bulletin</p>
      <h1 class="index-title">Iscriviti</h1>
      <p class="index-deck">Articoli, casi reali, ricerca. 1-2 al mese da Pianeta.Studio.</p>
    </header>
    <form action="/api/newsletter/subscribe" method="post" class="bulletin-subscribe-form">
      <input type="hidden" name="locale" value="it" />
      <input type="email" name="email" required placeholder="tu@email.it" class="bulletin-subscribe-input" />
      <button type="submit" class="cta-btn cta-primary">Iscrivimi</button>
    </form>
    <p class="bulletin-subscribe-note">Iscrivendoti accetti la nostra <a href="/privacy">privacy policy</a>.</p>
  </div>
</BaseLayout>

<style>
.bulletin-subscribe {
  max-width: var(--wrap-max);
  margin: 0 auto;
  padding: 80px 24px 96px;
}
.bulletin-subscribe-head {
  max-width: 560px;
  margin: 0 0 40px;
}
.bulletin-subscribe-form {
  display: flex;
  flex-direction: column;
  gap: 12px;
  max-width: 440px;
}
.bulletin-subscribe-input {
  width: 100%;
  padding: 0.75rem 1rem;
  border: 1px solid var(--pianeta-border-strong);
  border-radius: 12px;
  background: var(--pianeta-bg-card);
  color: var(--pianeta-text);
  font-size: 1rem;
  outline: none;
  transition: border-color 150ms;
}
.bulletin-subscribe-input:focus {
  border-color: var(--cta-primary);
}
.bulletin-subscribe-note {
  margin-top: 16px;
  font-size: 0.8rem;
  color: var(--pianeta-muted);
}
.bulletin-subscribe-note a {
  color: inherit;
  text-decoration: underline;
}
</style>
