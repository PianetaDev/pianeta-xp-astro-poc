---
import BaseLayout from '../../layouts/BaseLayout.astro';
const email = Astro.url.searchParams.get('email') || '';
---
<BaseLayout title="Disiscritto · Bulletin Pianeta" description="Iscrizione rimossa.">
  <div class="bulletin-flow">
    <h1 class="bulletin-flow-title">Confermato</h1>
    <p class="bulletin-flow-body">
      {email ? (
        <span><strong>{email}</strong> è stato rimosso dalla lista.</span>
      ) : (
        <span>L'iscrizione è stata rimossa.</span>
      )}
    </p>
    <p class="bulletin-flow-note">Non riceverai più nostre email. Grazie per averci letto fin qui.</p>
    <div class="bulletin-flow-actions">
      <a href="/" class="cta-btn cta-primary">Vai alla home</a>
      <a href="/bulletin/iscrivimi" class="cta-btn cta-ghost">Riscriviti</a>
    </div>
  </div>
</BaseLayout>

<style>
.bulletin-flow {
  max-width: 600px;
  margin: 0 auto;
  padding: 80px 24px 96px;
  text-align: center;
}
.bulletin-flow-title {
  font-size: var(--ty-hero);
  font-weight: 600;
  letter-spacing: var(--ty-hero-tracking);
  line-height: var(--ty-hero-lh);
  margin: 0 0 24px;
}
.bulletin-flow-body {
  font-size: 1.1rem;
  color: var(--pianeta-muted-strong);
  line-height: 1.6;
  margin: 0 0 12px;
}
.bulletin-flow-note {
  font-size: 0.875rem;
  color: var(--pianeta-muted);
  margin: 0 0 40px;
}
.bulletin-flow-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12px;
}
</style>
