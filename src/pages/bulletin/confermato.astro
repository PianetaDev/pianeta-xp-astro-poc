---
import BaseLayout from '../../layouts/BaseLayout.astro';
const email = Astro.url.searchParams.get('email') || '';
const already = Astro.url.searchParams.get('already') === '1';
---
<BaseLayout title={already ? 'Già iscritto · Bulletin Pianeta' : 'Iscrizione confermata · Bulletin Pianeta'} description="Iscrizione attiva.">
  <div class="bulletin-flow">
    <h1 class="bulletin-flow-title">
      {already ? 'Iscrizione già attiva' : 'Iscrizione confermata'}
    </h1>
    <p class="bulletin-flow-body">
      {already ? (
        <span>{email && <strong>{email}</strong>} risulta già iscritto. Tutto a posto.</span>
      ) : (
        <span>Da oggi riceverai il Bulletin di Pianeta.Studio{email && ` a `}{email && <strong>{email}</strong>}.</span>
      )}
    </p>
    <p class="bulletin-flow-note">Ti abbiamo mandato un'email di benvenuto col link al centro preferenze.</p>
    <div class="bulletin-flow-actions">
      <a href="/bulletin" class="cta-btn cta-primary">Leggi gli articoli →</a>
      <a href="/" class="cta-btn cta-ghost">Vai alla home</a>
    </div>
  </div>
</BaseLayout>

<style>
.bulletin-flow {
  max-width: 600px;
  margin: 0 auto;
  padding: 80px 24px 96px;
  text-align: center;
}
.bulletin-flow-title {
  font-size: var(--ty-hero);
  font-weight: 600;
  letter-spacing: var(--ty-hero-tracking);
  line-height: var(--ty-hero-lh);
  margin: 0 0 24px;
}
.bulletin-flow-body {
  font-size: 1.1rem;
  color: var(--pianeta-muted-strong);
  line-height: 1.6;
  margin: 0 0 12px;
}
.bulletin-flow-note {
  font-size: 0.875rem;
  color: var(--pianeta-muted);
  margin: 0 0 40px;
}
.bulletin-flow-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12px;
}
</style>
