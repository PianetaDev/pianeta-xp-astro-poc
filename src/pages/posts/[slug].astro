---
/**
 * /posts/[slug] — pagina propria per un post-carosello (PIA-1541 Fase 4).
 * Risolve photoIds → thumbnail_path via Supabase, poi mostra
 * il carosello a piena larghezza con descrizione del post.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { mediaSupabaseService } from '../../lib/server/media-supabase';

export const prerender = true;
export async function getStaticPaths() {
  const items = await getCollection('posts');
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props as any;
const { Content } = await render(item);
const data: any = item.data;
const title = data.title || item.id;
const photoIds: string[] = data.photoIds ?? [];
const formatDate = (d?: Date) =>
  d ? new Date(d).toLocaleDateString('it-IT', { day: '2-digit', month: 'long', year: 'numeric' }) : '';

// Risolvi thumbnail + caption per ogni photoId
interface ThumbRow { id: string; thumbnail_path: string | null; caption: string | null; }
let photos: ThumbRow[] = [];
if (photoIds.length > 0) {
  try {
    const db = mediaSupabaseService();
    const { data: rows } = await db
      .from('pianeta_media_photos')
      .select('id, thumbnail_path, caption')
      .in('id', photoIds);
    const byId = Object.fromEntries((rows ?? []).map((r: ThumbRow) => [r.id, r]));
    photos = photoIds.map((id) => byId[id]).filter(Boolean) as ThumbRow[];
  } catch {
    // Degradazione silenziosa senza credenziali
  }
}

const ogImage = data.ogImage || (photos[0]?.thumbnail_path
  ? `/api/media/thumb?path=${encodeURIComponent(photos[0].thumbnail_path)}`
  : undefined);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SocialMediaPosting',
  headline: title,
  description: data.description,
  url: new URL(`/posts/${item.id}`, Astro.site).toString(),
  image: ogImage,
  datePublished: data.date ? new Date(data.date).toISOString() : undefined,
  author: { '@type': 'Organization', name: 'Pianeta.Studio', url: 'https://xp.pianeta.studio' },
  keywords: (data.tags || []).join(', ') || undefined,
};
---
<BaseLayout
  title={`${title} — Pianeta.Studio`}
  description={data.description}
  ogImage={ogImage}
  noindex={data.draft === true}
>
  {jsonLd && <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />}

  <div class="post-detail">

    <!-- Carosello foto full-width -->
    <div class="post-carousel-full" aria-label="Carosello foto del post">
      {photos.length > 0 ? photos.map((p, i) => (
        <div class="post-slide">
          {p.thumbnail_path ? (
            <img
              src={`/api/media/thumb?path=${encodeURIComponent(p.thumbnail_path)}`}
              alt={p.caption ?? title}
              class="post-slide-img"
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          ) : (
            <div class="post-slide-placeholder" aria-hidden="true" />
          )}
          {p.caption && <p class="post-slide-caption">{p.caption}</p>}
        </div>
      )) : (
        <div class="post-slide-empty">Nessuna foto disponibile.</div>
      )}
    </div>

    <!-- Testo / metadata -->
    <div class="post-body">
      <header class="post-head">
        <p class="post-eyebrow">
          <a href="/hub">Hub</a>
          {' · '}
          <span>Post</span>
          {photos.length > 0 && <span> · {photos.length} foto</span>}
        </p>
        <h1 class="post-title">{title}</h1>
        {data.description && <p class="post-deck">{data.description}</p>}
        <div class="post-meta">
          {data.client && <span class="post-meta-item">{data.client}</span>}
          {data.date && <span class="post-meta-item">{formatDate(data.date)}</span>}
          {data.tags?.length > 0 && data.tags.map((tag: string) => (
            <span class="post-tag">#{tag}</span>
          ))}
        </div>
      </header>

      {item.body?.trim() && (
        <div class="post-prose">
          <Content />
        </div>
      )}

      <div class="post-nav">
        <a href="/hub" class="cta-btn cta-ghost">← Tutti i contenuti</a>
      </div>
    </div>

  </div>
</BaseLayout>

<script>
  // Scroll indicator — aggiorna il contatore di slide
  const init = () => {
    const carousel = document.querySelector<HTMLElement>('.post-carousel-full');
    if (!carousel) return;
    const slides = carousel.querySelectorAll<HTMLElement>('.post-slide');
    if (slides.length <= 1) return;

    const indicator = document.createElement('div');
    indicator.className = 'post-carousel-indicator';
    indicator.setAttribute('aria-hidden', 'true');
    carousel.appendChild(indicator);

    const update = () => {
      const scrollLeft = carousel.scrollLeft;
      const width = carousel.clientWidth;
      const current = Math.round(scrollLeft / width) + 1;
      indicator.textContent = `${current} / ${slides.length}`;
    };

    update();
    carousel.addEventListener('scroll', update, { passive: true });
  };

  document.addEventListener('astro:page-load', init);
</script>

<style>
  .post-detail {
    max-width: var(--wrap-max, 1200px);
    margin: 0 auto;
    padding: 80px 24px 96px;
  }

  .post-carousel-full {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    gap: 12px;
    border-radius: 20px;
    margin-bottom: 40px;
    position: relative;
  }
  .post-carousel-full::-webkit-scrollbar { display: none; }

  .post-slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    position: relative;
  }

  .post-slide-img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
    border-radius: 16px;
  }

  .post-slide-caption {
    font-size: 0.8125rem;
    color: var(--pianeta-muted);
    margin: 8px 4px 0;
    line-height: 1.4;
  }

  .post-slide-placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: var(--pianeta-bg-card, #f0f0ec);
    border-radius: 16px;
  }

  .post-slide-empty {
    padding: 48px 20px;
    color: var(--pianeta-muted);
    text-align: center;
    border: 1px dashed var(--pianeta-border-strong);
    border-radius: 16px;
    width: 100%;
  }

  .post-carousel-indicator {
    position: absolute;
    bottom: 12px;
    right: 16px;
    background: rgba(0,0,0,0.55);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 500;
    padding: 3px 8px;
    border-radius: 999px;
    pointer-events: none;
  }

  .post-body {
    max-width: 720px;
  }

  .post-eyebrow {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--pianeta-muted);
    margin: 0 0 16px;
  }
  .post-eyebrow a {
    color: inherit;
    text-decoration: none;
  }
  .post-eyebrow a:hover { color: var(--cta-primary, #FF6B33); }

  .post-title {
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin: 0 0 14px;
  }

  .post-deck {
    font-size: var(--ty-sub, 1.125rem);
    color: var(--pianeta-muted-strong);
    line-height: 1.55;
    margin: 0 0 20px;
    max-width: 600px;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 12px;
    margin-bottom: 32px;
  }

  .post-meta-item {
    font-size: 0.8125rem;
    color: var(--pianeta-muted);
  }

  .post-tag {
    font-size: 0.8125rem;
    color: var(--cta-primary, #FF6B33);
  }

  .post-prose { margin-bottom: 40px; }

  .post-nav { margin-top: 32px; }

  @media (min-width: 900px) {
    .post-carousel-full { max-height: 600px; }
    .post-slide-img { aspect-ratio: unset; height: 600px; }
    .post-slide-placeholder { aspect-ratio: unset; height: 600px; }
  }
</style>
