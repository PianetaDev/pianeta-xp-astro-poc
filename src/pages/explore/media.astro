---
/**
 * /explore/media — Pianeta.Watchers: archivio fotografico esplorabile di Pianeta.Studio
 *
 * Motore Three.js (MediaCloud.vue) su foto dei workshop e dei progetti.
 * URL invariato rispetto al lancio (noindex, zero link interni esistenti):
 * cambio URL rimandato a quando si decide la navigazione pubblica dell'hub.
 *
 * Powered by: MediaCloud.vue (Astro island client:only) + Three.js sprite cloud
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaCloud from '../../components/vue/site/MediaCloud.vue';
---

<BaseLayout
  title="Pianeta.Watchers — Archivio fotografico"
  description="Pianeta.Watchers: esplora le foto dei workshop e dei progetti Pianeta.Studio per prossimità visiva. Powered by Three.js."
  noindex={true}
>
  <style is:global>
    /* Full-bleed canvas: nessun padding dal layout base */
    main.media-explore-page {
      padding: 0 !important;
      margin: 0 !important;
      max-width: none !important;
      height: 100vh;
      overflow: hidden;
    }
  </style>
  <main class="media-explore-page">
    <MediaCloud client:only="vue" />
  </main>
</BaseLayout>
