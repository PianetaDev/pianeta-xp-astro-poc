---
interface Props {
  href: string;
  title: string;
  deck?: string;
  kicker?: string;
  image?: string;
  video?: string;
  portrait?: boolean;
}
const { href, title, deck, kicker, image, video, portrait = false } = Astro.props;
const cover = image || (portrait ? '/og/placeholder-4_5.png' : '/og/placeholder-1_1.png');
---
<a href={href} class:list={['index-card', portrait && 'is-portrait', video && 'has-video']}>
  <div class="index-card-img">
    {video ? (
      <>
        <video class="index-card-video" autoplay muted loop playsinline poster={cover} aria-hidden="true">
          <source src={video} type="video/mp4" />
        </video>
        <img class="index-card-poster" src={cover} alt={title} loading="lazy" decoding="async" />
      </>
    ) : (
      <picture>
        {/^.*\.(png|jpe?g)$/i.test(cover) && (
          <source srcset={cover.replace(/\.(png|jpe?g)$/i, '-card.webp')} type="image/webp" />
        )}
        <img src={cover} alt={title} loading="lazy" decoding="async" />
      </picture>
    )}
  </div>
  <div class="index-card-body">
    {kicker && <span class="index-card-kicker">{kicker}</span>}
    <h3 class="index-card-title">{title}</h3>
    {deck && <p class="index-card-deck">{deck}</p>}
  </div>
</a>
