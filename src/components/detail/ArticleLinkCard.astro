---
// Componente link negli articoli (allegato 1 su PIA-1620):
// card bianca con bordo, testo a sinistra, icona "apri" arancio a destra.
interface Props {
  href: string;
  title: string;
  description?: string;
  external?: boolean;
}
const { href, title, description, external = false } = Astro.props;
---
<a
  href={href}
  class="article-link-card"
  {...external ? { target: '_blank', rel: 'noopener' } : {}}
>
  <div class="alc-body">
    <span class="alc-title">{title}</span>
    {description && <span class="alc-desc">{description}</span>}
  </div>
  <span class="alc-icon" aria-hidden="true">↗</span>
</a>

<style>
  .article-link-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    background: var(--pianeta-bg-card);
    border: 1px solid var(--pianeta-border);
    border-radius: var(--radius-card-sm);
    text-decoration: none;
    color: var(--pianeta-text);
    transition: border-color 150ms ease, box-shadow 150ms ease;
    margin: 1.2em 0;
  }
  .article-link-card:hover {
    border-color: var(--cta-primary);
    box-shadow: 0 4px 14px rgba(255,107,51,.10);
  }
  .alc-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .alc-title {
    font-size: var(--ty-meta);
    font-weight: 600;
    color: var(--pianeta-text);
    line-height: 1.3;
  }
  .alc-desc {
    font-size: 12px;
    color: var(--pianeta-muted);
    line-height: 1.4;
  }
  .alc-icon {
    flex-shrink: 0;
    font-size: 18px;
    color: var(--cta-primary);
    font-weight: 600;
  }
</style>
